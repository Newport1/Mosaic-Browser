{
  "name": "mosaic-browser",
  "version": "0.1.0",
  "description": "A tiny, keyboard-friendly tiled browser for focused work.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mosaic.browser",
    "productName": "Mosaic",
    "files": ["src/**/*", "package.json"],
    "artifactName": "Mosaic-${version}-${os}-${arch}.${ext}",
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis", "portable"] }
  }
}
